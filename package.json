{
  "name": "opennotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Markdown editor for your files and folders",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --project performance",
    "test:dist": "npm run build && OPEN_NOTES_PREVIEW=1 playwright test",
    "audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run test:policies && npm run coverage && npm run test:e2e && npm run test:dist",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js:fix": "eslint . --fix --max-warnings 0",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "test:policies": "node --test tests/policies/*.test.mjs",
    "test:compatibility": "npm run build && OPEN_NOTES_PREVIEW=1 playwright test --project dist-firefox --project dist-webkit",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; for (const path of [\"dist\", \"coverage\", \"playwright-report\", \"test-results\", \".playwright-cli\", \".vitest-attachments\", \"tests/__screenshots__\", \"node_modules/.vite\"]) rmSync(path, { recursive: true, force: true });'"
  },
  "dependencies": {
    "@codemirror/commands": "6.7.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.3.0",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.10.3",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.34.1",
    "@hotwired/stimulus": "3.2.2",
    "@lezer/highlight": "1.2.1",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.2.4",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@11.16.0"
}
