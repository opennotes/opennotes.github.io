{
  "id": "./",
  "name": "Open Notes",
  "short_name": "Open Notes",
  "description": "Заметки, файлы и папки. Простой Markdown-редактор для ежедневной работы.",
  "lang": "ru",
  "start_url": "./edit.html?app=1",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Редактор",
      "url": "./edit.html"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
